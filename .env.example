# ============================================
# PROMPTVERSE AI — Environment Variables
# Copy this file to ".env.local" for local dev.
# On Netlify, add these under Site settings > Environment variables.
# NEVER commit ".env.local" to GitHub.
# ============================================

# --- Supabase (from Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in API routes / server code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Server-only.
PAYSTACK_SECRET_KEY=

# --- Google Ads ---
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=
NEXT_PUBLIC_GOOGLE_AD_SLOT_HOME=
NEXT_PUBLIC_GOOGLE_AD_SLOT_DETAIL=
NEXT_PUBLIC_GAM_NETWORK_CODE=
NEXT_PUBLIC_GAM_REWARDED_AD_UNIT=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PROMPT_UNLOCK_PRICE_NGN=1000
ADMIN_EMAIL=jamilusayau@gmail.com
